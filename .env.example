# ==========================================
# Scholar 6-Agent 学术工作流引擎 - 环境配置
# 复制此文件为 .env 并填入你的 API Key
# ==========================================

# ==========================================
# 1. 服务商 API Keys (Provider Pool)
# ==========================================
# OpenAI / Azure OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（代码与逻辑极强，主推）
DEEPSEEK_KEY=sk-your-deepseek-key

# SiliconFlow（提供满血版开源大模型，如 Kimi, LLaMA）
SILICONFLOW_KEY=sk-your-siliconflow-key

# 秘塔 MCP API Key（专用于中文文献检索）
METASO_API_KEY=mk-your-metaso-key

# ==========================================
# 2. 学术搜索配置 (Data Sources)
# ==========================================
# IEEE Xplore API (推荐！用于抓取理工科/金融顶会文献)
IEEE_API_KEY=your-ieee-api-key

# Semantic Scholar API Key (用于英文文献基础检索)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key

# CORE API Key (可选备用)
CORE_API_KEY=your-core-api-key

# 注意: arXiv 引擎无须 API Key，系统默认内置。

# ==========================================
# 3. Agent LLM 分配配置 (Routing)
# ==========================================
# 主控 Agent (Lead Author) - 规划+决策
AGENT_LEAD_AUTHOR_PROVIDER=deepseek
AGENT_LEAD_AUTHOR_MODEL=deepseek-reasoner
AGENT_LEAD_AUTHOR_TEMP=0.7

# 审查员 Agent (Reviewer) - 文献综述+Gap分析
AGENT_REVIEWER_PROVIDER=siliconflow
AGENT_REVIEWER_MODEL=Pro/moonshotai/Kimi-K2.5
AGENT_REVIEWER_TEMP=0.5

# 采集员 Agent (Data Crawler) - 网页抓取与清洗
AGENT_CRAWLER_PROVIDER=deepseek
AGENT_CRAWLER_MODEL=deepseek-chat
AGENT_CRAWLER_TEMP=0.1

# 分析员 Agent (Data Analyst) - 代码生成
AGENT_DATA_PROVIDER=deepseek
AGENT_DATA_MODEL=deepseek-chat
AGENT_DATA_TEMP=0.1

# ==========================================
# 4. 输出与运行配置
# ==========================================
OUTPUT_DIR=./output
VECTOR_DB_DIR=./vector_db
MAX_SEARCH_RESULTS=20
SANDBOX_TIMEOUT=120