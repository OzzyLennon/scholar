# Scholar 5-Agent 学术工作流引擎 - 环境配置
# 复制此文件为 .env 并填入你的 API Key

# ==========================================
# LLM API Keys（至少配置一个）
# ==========================================

# OpenAI / Azure OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（推荐用于主控和审查员）
DEEPSEEK_KEY=sk-your-deepseek-key

# SiliconFlow（DeepSeek V3.2 等模型）
SILICONFLOW_KEY=sk-your-siliconflow-key

# 火山引擎 ARK（豆包、Kimi、GLM）
ARK_KEY=your-ark-api-key

# 腾讯云 Coding（豆包代码）
TENCENT_KEY=sk-your-tencent-key

# ==========================================
# Agent LLM 分配配置（统一管理）
# ==========================================

# 主控 Agent (Lead Author) - 规划+决策
AGENT_LEAD_AUTHOR_PROVIDER=deepseek
AGENT_LEAD_AUTHOR_MODEL=deepseek-reasoner
AGENT_LEAD_AUTHOR_TEMP=0.7

# 审查员 Agent (Reviewer) - 文献综述+Gap分析
AGENT_REVIEWER_PROVIDER=deepseek
AGENT_REVIEWER_MODEL=deepseek-reasoner
AGENT_REVIEWER_TEMP=0.5

# 数据研究员 Agent (Data Researcher) - 代码生成
AGENT_DATA_PROVIDER=tencent
AGENT_DATA_MODEL=doubao-seed-2.0-code
AGENT_DATA_TEMP=0.3

# ==========================================
# 学术搜索配置（可选）
# ==========================================

# Semantic Scholar API Key（用于英文文献检索）
# 申请地址：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key

# CORE API Key（可选备用）
CORE_API_KEY=your-core-api-key

# 秘塔MCP API Key（用于中文文献检索）
METASO_API_KEY=your-metaso-api-key

# ==========================================
# 输出配置
# ==========================================

# 输出目录
OUTPUT_DIR=./output

# 向量数据库目录
VECTOR_DB_DIR=./vector_db

# 最大搜索结果数
MAX_SEARCH_RESULTS=20

# 沙箱超时时间（秒）
SANDBOX_TIMEOUT=120
